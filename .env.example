# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION BOUNDARY (Required for Production PostgreSQL, Auth, RLS & Private Evidence Storage)
# Public browser client configuration (safe for Vite client bundle when RLS is enabled):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side privileged key (NEVER expose in VITE_ client variables; used only in trusted server functions):
SUPABASE_SERVICE_ROLE_KEY=""
